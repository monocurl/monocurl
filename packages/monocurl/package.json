{
  "name": "monocurl",
  "version": "0.2.9",
  "description": "Browser-side TypeScript controller for the Monocurl WebAssembly runtime.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "npm run check && tsc -p tsconfig.json && npm run build:wasm",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "monocurl",
    "wasm",
    "animation",
    "math"
  ],
  "author": {
    "name": "enigmurl",
    "email": "43832426+enigmurl@users.noreply.github.com",
    "url": "https://monocurl.com"
  },
  "license": "MIT",
  "homepage": "https://monocurl.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monocurl/monocurl.git"
  },
  "bugs": {
    "url": "https://github.com/monocurl/monocurl/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
