# example: sampled surface / batch kernels

import std.util
import std.math
import std.color
import std.mesh
import std.anim
import std.scene

# A 70 by 70 grid whose height and color come from a lambda with moving
# parameters; every vertex is recomputed each frame while it morphs.
let samples = 70
let color_keys = [0 -> BLUE, 0.35 -> TEAL, 0.6 -> YELLOW, 0.85 -> ORANGE, 1 -> RED]

let height = |x, y, freq, mix| {
    let waves = sin(freq * x) * cos(freq * y)
    let rings = cos(freq * 0.8 * sqrt(x * x + y * y))
    return 0.3 * ((1 - mix) * waves + mix * rings)
}

let Ripple = |freq, mix|
    point_map{|p| [p[0], p[1], height(p[0], p[1], freq, mix)]}
    ColorGrid(
        |pos, idx| keyframe_lerp(color_keys, 0.5 + 1.6 * height(pos[0], pos[1], freq, mix)),
        [-1, 1, samples],
        [-1, 1, samples]
    )

camera = Camera([2.6, -2.4, 1.7], [0, 0, 0], [0, 0, 1])

slide "Surface"
    mesh axis =
        shift{[0, 0, -0.4]}
        Axis3d(basis: [1r, 1u, 1b], color: GRAY, grid_color: nil, label_up: [2r, 2u, 0.8b])
    mesh surface = Ripple(freq: 3, mix: 0)
    play Fade(0.8)

slide "Morph"
    surface.mix = 1
    surface.freq = 5
    play Lerp(4)

slide "Back"
    surface.mix = 0
    surface.freq = 3
    play Lerp(4)
