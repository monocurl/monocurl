# example: particle swarm / many objects

import std.util
import std.math
import std.color
import std.mesh
import std.anim
import std.scene

# A spiral galaxy of nine hundred stars. Each star has its own orbit, size
# and color, re-evaluated every frame as the disc turns: the inner stars
# lap the outer ones, so the arms wind up and shear as time passes.
background = [0.03, 0.03, 0.06, 1]
let palette = [0 -> [1, 0.9, 0.7, 1], 0.25 -> ORANGE, 0.5 -> [0.95, 0.5, 0.6, 1], 0.75 -> [0.5, 0.6, 1, 1], 1 -> [0.3, 0.7, 1, 1]]

# a cheap hash: three independent-looking numbers in [0, 1) per star
let hash = |i, salt| mod(sin(i * 12.9898 + salt * 78.233) * 43758.5453, 1)

let Star = |i, t| {
    let u = hash(i, 1)
    let v = hash(i, 2)
    let w = hash(i, 3)
    let r = 0.06 + 1.9 * u * u
    # two arms, each a logarithmic spiral, with scatter that grows outward
    let arm = PI * mod(i, 2)
    let spread = (v - 0.5) * (0.5 + 0.9 * u)
    let base = arm + 2.2 * ln(1 + 3 * r) + spread
    # keplerian rotation: angular speed falls off with radius
    let angle = base + t * 0.7 / sqrt(0.15 + r)
    let pos = [cos(angle) * r * 1.5, sin(angle) * r * 0.55 + 0.05 * (w - 0.5) * u, 0]
    let col = keyframe_lerp(palette, u * 0.85 + 0.15 * w)
    let size = 0.008 + 0.022 * (1 - u) * (0.5 + 0.5 * w)
    return fill{col} stroke{CLEAR} center{pos} Circle(size, samples: 12)
}

let Galaxy = |n, t| block {
    for (i in range(0, n)) {
        . Star(i, t)
    }
}

mesh galaxy = Galaxy(n: 900, t: 0)

slide "Galaxy"
    play Fade(0.8)

slide "Turn"
    galaxy.t = 9
    play rate{linear} Lerp(12)
