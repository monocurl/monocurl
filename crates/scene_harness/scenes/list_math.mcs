# list arithmetic: elementwise + and -, scalar broadcast for * and /, nested
# lists, negation, and the vector natives, ending in a length mismatch

import std.util
import std.math

let u = [1, 2, 3]
let v = [0.5, -1, 2]
print [u + v, u - v, v - u]
print [u * 2, 2 * u, u * 0.5, u / 2, 6 / u]
print [-u, -[1.5, [2, -3]], -[]]

let m = [[1, 2], [3, 4]]
print [m + m, m - [[1, 1], [1, 1]], m * 3, 0.5 * m, m / 4, -m]
print [[[1, [2]]] + [[3, [4]]], [[1, 2], 3] * 2]

print [dot(u, v), dot([1, 0], [0, 1]), dot([], []), norm([3, 4]), norm(u)]
print [cross([1, 0, 0], [0, 1, 0]), cross(u, v), cross(v, u)]
# sum folds from the int 0, so summing a list of lists fails (FUZZ_FINDINGS.md #4)
print [sum(u), sum(v), sum([]), len(m), len(m[0])]

# lists built in a loop and combined
var acc = [0, 0, 0]
for (i in range(0, 4)) {
    acc = acc + [i, i * i, 1] * 0.5
}
print acc

var points = []
for (t in range(0, 3)) {
    points .= [t, t * t] / 2
}
print [points, points[2] - points[1], len(points)]

print [u == [1, 2, 3], u == [1.0, 2, 3], u != v, 2 in u, 5 in u]

print "mismatch next"
print u + [1, 2]
print "unreachable"
